# Copy to .env (git-ignored). docker-compose and setup.sh read it automatically.

# Public IP of the server (used to print the SPF records)
SERVER_IP=179.184.50.129

# Account the REST API logs in with (must exist in accounts.conf)
SMTP_USER=contact@potira.io
SMTP_PASS=change_me_strong_password

# Default sender when the request has no "from"
FROM_EMAIL=contact@potira.io

# Domains the API is allowed to send "from" (comma-separated)
ALLOWED_FROM_DOMAINS=potira.io,juliovianadev.com
